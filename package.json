{
  "name": "hermes-owlet",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Hermes Owlet \u2014 the animated 2.5D character head for the Nous Research Hermes Agent companion app.",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b --pretty false",
    "export:svg": "esbuild scripts/export-static-svg.tsx --bundle --platform=node --format=cjs --outfile=node_modules/.cache/hermes-owlet-export.cjs --log-level=warning && node node_modules/.cache/hermes-owlet-export.cjs",
    "trace:art": "node scripts/trace-art.mjs"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/node": "^22.20.1",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "typescript": "^5.6.3",
    "vite": "^5.4.11",
    "esbuild": "^0.24.0"
  }
}
