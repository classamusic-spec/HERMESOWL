{
  "name": "hermes-owlet",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "description": "Hermes Owlet — the animated 2.5D character head for the Nous Research Hermes Agent companion app.",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b --pretty false",
    "export:svg": "esbuild scripts/export-static-svg.tsx --bundle --platform=node --format=cjs --outfile=node_modules/.cache/hermes-owlet-export.cjs --log-level=warning && node node_modules/.cache/hermes-owlet-export.cjs",
    "trace:art": "node scripts/trace-art.mjs",
    "verify:art": "node scripts/verify-art.mjs",
    "verify:activity": "node scripts/verify-activity.mjs"
  },
  "dependencies": {
    "better-sqlite3": "^12.11.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^22.20.1",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^6.1.1",
    "esbuild": "^0.28.2",
    "typescript": "^5.6.3",
    "vite": "^8.2.2"
  }
}
